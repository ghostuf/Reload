# Copy this file to .env and fill it in: `cp .env.example .env`
# docker-compose.yml reads this single file for every service.
# No real secrets belong in this .example file -- only placeholders.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=reload
POSTGRES_PASSWORD=changeme
POSTGRES_DB=reloaddb

# ---- Backend ------------------------------------------------------------
# Host is the compose service name "postgres", not localhost: inside the
# compose network, "localhost" means the backend container itself.
DATABASE_URL=postgres://reload:changeme@postgres:5432/reloaddb?sslmode=disable

PORT=8080

# Signs access tokens. Required -- the server refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# The exact origin the browser loads the frontend from. Cookie auth forbids
# a wildcard, so this has to be the one real origin, not a pattern.
FRONTEND_ORIGIN=http://localhost:3000

# Leave empty to scope cookies to the API's own host. Set to your apex domain
# (e.g. ".example.com") only when the frontend and backend share one.
COOKIE_DOMAIN=
# Must be true for any origin served over HTTPS -- which includes every real
# deployment, and is required outright when COOKIE_SAMESITE=none.
COOKIE_SECURE=false
# "lax" works for local HTTP development, where the frontend and backend are
# treated as the same site. A production deployment with the frontend and
# backend on different domains needs "none" (with COOKIE_SECURE=true),
# otherwise the browser never attaches the cookie cross-site.
COOKIE_SAMESITE=lax

# ---- Frontend -----------------------------------------------------------
# Inlined into the browser bundle at build time: the address a visitor's
# browser can reach the API at. Locally this is the published host port;
# in production it is the API's real public URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Used only by code running inside the frontend container itself (Server
# Components doing their own fetch). Inside compose this is the backend's
# service name on the compose network -- "localhost" here would mean the
# frontend container, not the backend. Not used at all once the frontend and
# backend are deployed as separate services outside compose.
INTERNAL_API_URL=http://backend:8080
