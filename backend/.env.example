DATABASE_URL=postgres://reload:reload@localhost:5432/reloaddb?sslmode=disable
PORT=8080

# Signs access tokens. Required — the server refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Exact origin allowed to send credentialed requests. Cookie auth forbids "*".
FRONTEND_ORIGIN=http://localhost:3000

# Leave the domain empty to scope cookies to the API host itself.
COOKIE_DOMAIN=
# Must be true anywhere the site is served over HTTPS, and is required
# outright when COOKIE_SAMESITE=none.
COOKIE_SECURE=false
# "lax", "strict", or "none". "none" is what a frontend and backend on
# different domains need (with COOKIE_SECURE=true) for the cookie to survive
# a cross-site request at all.
COOKIE_SAMESITE=lax

# The frontend's public URL, used to build the success_url/failure_url eSewa
# redirects back to after payment.
FRONTEND_URL=http://localhost:3000

# "mock" or "esewa". Defaults to "esewa" whenever ESEWA_SECRET_KEY is set
# (which it is, below) -- set to "mock" to fall back to the no-payment
# POST /checkout flow instantly.
PAYMENT_MODE=esewa

# eSewa ePay v2 (sandbox/test mode). "sandbox" or "production" -- only picks
# the default form/status URLs below when ESEWA_FORM_URL / ESEWA_STATUS_URL
# are left unset.
ESEWA_ENV=sandbox
# eSewa's own fixed UAT merchant code and secret key -- not secrets of this
# app's, safe as committed placeholders. A production deployment must
# replace all three with the real values eSewa issues, and the secret key
# must never reach the frontend.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
